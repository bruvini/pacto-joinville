# Variáveis de ambiente do projeto — copie para `.env` e preencha.
# NUNCA versione o arquivo `.env` real (contém configuração de ambiente).
# Estas chaves "PUBLISHABLE/ANON" são públicas por design (vão para o browser);
# a proteção dos dados é feita pela RLS no Postgres, não pelo sigilo da chave.
# A chave service_role JAMAIS deve aparecer no frontend nem no repositório.

VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key-publica"
VITE_SUPABASE_PROJECT_ID="seu-project-id"

# Usadas no SSR (server-side)
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-anon-key-publica"
SUPABASE_PROJECT_ID="seu-project-id"

# CONFIGURAÇÃO PÚBLICA DO FRONTEND/SSR.
# O .env raiz é versionado porque o Lovable Cloud usa VITE_* durante o build.
# Regra: somente URL, project-ref e chave ANON/PUBLISHABLE podem entrar no .env.
# NUNCA coloque service_role, secret key, senha, token privado ou credenciais de terceiros.
# Overrides locais: .env.local (ignorado pelo Git).
# O build valida este contrato com scripts/check-env-contract.mjs.

VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-ou-publishable-key-publica"
VITE_SUPABASE_PROJECT_ID="seu-project-ref"

# Espelho para SSR/TanStack Start — também são valores públicos.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-anon-ou-publishable-key-publica"
SUPABASE_PROJECT_ID="seu-project-ref"

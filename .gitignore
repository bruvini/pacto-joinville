# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# O deploy (Lovable) usa bun/bun.lock; o npm local é só para testes e lint.
package-lock.json
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# NOTA: o Lovable Cloud injeta as variáveis VITE_* a partir do .env versionado
# no build. Por isso o .env É versionado aqui — ele contém apenas a chave
# ANON/PUBLISHABLE (pública por design; a proteção dos dados é a RLS no Postgres).
# A chave service_role JAMAIS deve ser colocada neste arquivo.
# Overrides locais ficam em .env.local (ignorado por *.local acima).

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Artefatos transitórios do Graphify (os relatórios e o grafo versionados ficam em graphify-out/)
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/.graphify_analysis.json
graphify-out/.graphify_ast.json
graphify-out/.graphify_chunk_*.json
graphify-out/.graphify_detect.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_labels.json.sig
graphify-out/.graphify_semantic*.json
graphify-out/.graphify_uncached.txt
